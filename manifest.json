{
  "manifest_version": 3,
  "name": "JourneyTracker",
  "version": "0.0.1",
  "description": "Track your job application journey. Everything stays in your browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "commands": {
    "capture-page": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Read this page into JourneyTracker"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://job-boards.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "exclude_matches": [
        "https://*.myworkdayjobs.com/*/apply",
        "https://*.myworkdayjobs.com/*/apply/*"
      ],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Open JourneyTracker"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
